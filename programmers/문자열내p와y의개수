#include <string>
#include <iostream>
using namespace std;

bool solution(string s)
{
    bool answer = true;

    int cnt1 = 0;
    int cnt2 = 0;
    int n = s.size();
    for(int i = 0 ; i < n ; ++i)
    {
        if(s[i] == 'p' || s[i] == 'P')
        {
            cnt1++;
        }
        else if (s[i] == 'Y' || s[i] == 'y')
        {
            cnt2++;
        }
    }
    if(cnt1 == cnt2) answer = true;
    else answer = false;
    return answer;
}
